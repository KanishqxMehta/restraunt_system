# Docker Compose supplies local defaults and generates its own signing secret.
# For running npm directly, copy to .env and generate a secret:
# node -e 'console.log(require("node:crypto").randomBytes(48).toString("base64url"))'
DATABASE_URL=postgresql://isocode:isocode_local@localhost:5432/isocode
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Explicitly opt in to public synthetic demo accounts; never use on a real deployment.
ENABLE_DEMO_DATA=false
# Deferred until the final feature iteration.
GEMINI_API_KEY=
GEMINI_MODEL=
