generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  KITCHEN_STAFF
  CENTRAL_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  NEW
  PREPARING
  READY
  HANDED_OFF
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
}

// Better Auth owns credentials and sessions. App roles cannot be set by signup.
model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  role             Role     @default(CUSTOMER)
  marketingOptIn   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      OutletMembership[]
  orders           Order[]
  quotes           CheckoutQuote[]
  redemptions      CouponRedemption[]
  kitchenEvents    OrderEvent[]
  loyaltyAccount   LoyaltyAccount?
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Outlet {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  city               String
  address            String
  latitude           Float
  longitude          Float
  deliveryRadiusKm   Float
  fssaiLicense       String
  isCloudKitchen     Boolean  @default(false)
  isActive           Boolean  @default(true)
  minimumPrepMinutes Int      @default(20)
  packingMinutes     Int      @default(5)
  kitchenCapacity    Int      @default(3)
  opensAtMinute      Int      @default(0)
  closesAtMinute     Int      @default(1440)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  memberships        OutletMembership[]
  availability       OutletAvailability[]
  orders             Order[]
}

model OutletMembership {
  userId   String
  outletId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@id([userId, outletId])
  @@index([outletId])
}

model MenuItem {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  category         String
  imageUrl         String?
  isVeg            Boolean
  allergens        String[]
  spiceLevel       Int      @default(1)
  basePrepMinutes  Int
  prepStation      String   @default("MAIN")
  batchCapacity    Int      @default(1)
  isActive         Boolean  @default(true)
  availableFromMinute Int?
  availableToMinute   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  portions         MenuPortion[]
  addons           MenuAddon[]
  availability     OutletAvailability[]
}

model MenuPortion {
  id                  String   @id @default(cuid())
  itemId              String
  item                MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name                String
  prepMinutesOverride Int?
  prices              CityPrice[]
  @@unique([itemId, name])
}

model CityPrice {
  id          String      @id @default(cuid())
  portionId   String
  portion     MenuPortion @relation(fields: [portionId], references: [id], onDelete: Cascade)
  city        String
  pricePaise  Int
  @@unique([portionId, city])
}

model MenuAddon {
  id               String   @id @default(cuid())
  itemId           String
  item             MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name             String
  pricePaise       Int
  extraPrepMinutes Int      @default(0)
  allergens        String[] @default([])
  @@unique([itemId, name])
}

model OutletAvailability {
  outletId    String
  itemId      String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  @@id([outletId, itemId])
  @@index([itemId])
}

// Purchased names and prices are snapshots: later menu edits cannot change receipts.
model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  customerId        String
  customer          User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  outletId          String
  outlet            Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod
  totalPaise        Int
  includedTaxPaise  Int
  promisedReadyAt   DateTime
  originalPromiseAt DateTime
  estimateSource    String        @default("PROVISIONAL")
  aiEstimatedMinutes Int?
  aiExplanation     String?
  managerOverrideReason String?
  quoteId           String?       @unique
  quote             CheckoutQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  idempotencyKey    String?
  subtotalPaise     Int           @default(0)
  discountPaise     Int           @default(0)
  couponCode        String?
  pointsRedeemed    Int           @default(0)
  pointsDiscountPaise Int         @default(0)
  pointsEarned      Int           @default(0)
  isCatering        Boolean       @default(false)
  cateringStatus    CateringStatus @default(NOT_CATERING)
  cateringNotes     String?
  cateringConfirmedAt DateTime?
  cateringConfirmedBy String?
  guestCount        Int?
  eventDate         DateTime?
  specialInstructions String?
  deliveryAddress   String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  paymentExpiresAt  DateTime?
  paymentAttempts   PaymentAttempt[]
  redemption        CouponRedemption?
  loyaltyTransactions LoyaltyTransaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
  events            OrderEvent[]
  notifications     OrderNotification[]
  @@index([outletId, status, createdAt])
  @@index([customerId, createdAt])
  @@unique([customerId, idempotencyKey])
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  order            Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name             String
  portionName      String
  quantity         Int
  unitPricePaise   Int
  prepMinutes      Int
  isVeg            Boolean
  allergens        String[]
  addons           Json @default("[]")
  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())
  actorId   String?
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([orderId, createdAt])
}

model CheckoutQuote {
  id            String   @id @default(cuid())
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  input         Json
  fingerprint   String
  snapshot      Json
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  order         Order?
  @@index([customerId, expiresAt])
}

enum DiscountType {
  PERCENT
  FLAT
}

model Coupon {
  id               String @id @default(cuid())
  code             String @unique
  discountType     DiscountType
  value            Int
  minOrderPaise    Int @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  perCustomerLimit Int?
  isActive         Boolean @default(true)
  startsAt         DateTime
  expiresAt        DateTime
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id         String @id @default(cuid())
  couponId   String
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customerId String
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId    String @unique
  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  @@index([couponId, customerId])
}

enum MockPaymentOutcome {
  SUCCESS
  FAILED
  CANCELLED
}

model PaymentAttempt {
  id             String @id @default(cuid())
  orderId        String
  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String
  method         PaymentMethod
  outcome        MockPaymentOutcome
  createdAt      DateTime @default(now())
  @@unique([orderId, idempotencyKey])
}

enum NotificationChannel {
  WHATSAPP
  SMS
}

enum NotificationEvent {
  ORDER_CONFIRMED
  COOKING_STARTED
  READY_FOR_PICKUP
  PROMISE_EXTENDED
  ORDER_HANDED_OFF
}

model OrderNotification {
  id               String              @id @default(cuid())
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel          NotificationChannel
  event            NotificationEvent
  recipient        String
  title            String
  body             String
  whatsappDeepLink String?
  gatewayMessageId String
  sentAt           DateTime            @default(now())

  @@index([orderId, sentAt])
}

enum CateringStatus {
  NOT_CATERING
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
}

enum LoyaltyTxType {
  EARNED
  REDEEMED
  REFUNDED
}

model LoyaltyAccount {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance    Int                  @default(0)
  lifetimeEarned   Int                  @default(0)
  lifetimeRedeemed Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        LoyaltyTxType
  points      Int
  description String
  createdAt   DateTime       @default(now())

  @@index([accountId, createdAt])
}


